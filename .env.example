# =============================================================================
# Chaves OPCIONAIS — o projeto funciona 100% sem nenhuma delas (fallback local).
# Copie para .env e preencha só o que tiver. Como obter cada uma:
# docs/HUMAN_DEPENDENCIES.md, seção 1.
# =============================================================================

# Tier 1 ASR (whisper-large-v3-turbo) + LLM de roteiro
GROQ_API_KEY=

# Tier 1 VLM/LLM — ATENÇÃO: o free tier usa os dados para treino; o router
# bloqueia este provedor para mídia sensível do MEI automaticamente.
GEMINI_API_KEY=

# Tier 2 ASR/TTS/VLM (10.000 Neurons/dia)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Música/SFX com licença comercial (cache mínimo 24h)
PIXABAY_API_KEY=

# B-roll generativo via Hugging Face ZeroGPU (também precisa REELS_ENABLE_ZEROGPU=1)
HF_TOKEN=

# Tier 2 LLM para prompts longos
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Tier 2 VLM
NVIDIA_API_KEY=

# --- Coleta de conteúdo (case Stone x Inteli) ---
# Apify (coleta Instagram, PAGA): Console > Settings > API & Integrations
APIFY_TOKEN=
# YouTube Data API v3 (quota gratuita diária)
YOUTUBE_API_KEY=

# --- Comportamento do projeto (ver CLAUDE.md §3) ---
REELS_WORKSPACE=./workspace
REELS_COMMERCIAL=1
REELS_OFFLINE=0
REELS_ALLOW_PLACEHOLDER_AUDIO=0
REELS_ALLOW_AGPL=0
REELS_ENABLE_ZEROGPU=0
PIPER_MODEL_PATH=models/piper/pt_BR-faber-medium.onnx
REELS_LOG_LEVEL=INFO

# Skills de vídeo (opcionais; sem chave a skill correspondente fica BLOQUEADA, nunca vira erro)
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
